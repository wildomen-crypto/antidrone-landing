{
  "name": "antidrone-landing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "typecheck": "next typegen && tsc --noEmit",
    "build": "next build && npm run build:worker",
    "build:pages": "node scripts/build-pages.cjs",
    "build:joomla": "node scripts/build-joomla.cjs",
    "check": "npm run typecheck && npm run test:unit && npm run build",
    "test:unit": "tsc -p tsconfig.tests.json && node --test tests/unit/geometry.test.cjs tests/unit/leads.test.cjs tests/unit/pricing.test.cjs tests/unit/joomla-submit.test.cjs tests/unit/joomla-embed.test.cjs",
    "test:browser": "node tests/browser.mjs",
    "test:wide": "node tests/wide-browser.mjs",
    "test:compact": "node tests/compact-browser.mjs",
    "test:responsive": "node tests/responsive-browser.mjs",
    "test:overlay": "node tests/overlay-browser.mjs",
    "test:quote": "node tests/quote-browser.mjs",
    "build:worker": "tsc -p tsconfig.tests.json --outDir .local/runtime",
    "leads": "npm run build:worker && node scripts/leads.cjs",
    "start": "next start --hostname 127.0.0.1 --port 3100"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "typescript": "5.9.3"
  }
}
