<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="3.10" client="site" method="upgrade">
  <name>Антидроновая защита — 3D и проектирование</name>
  <author>Топинженер</author><version>1.1.1</version><creationDate>October 2026</creationDate>
  <description>Страница проектирования для Joomla 3.10.12 и шаблона yoo_monday. Ресурсы локальные; Node на хостинге не требуется.</description>
  <files><filename module="mod_antidrone_design">mod_antidrone_design.php</filename><filename>helper.php</filename><folder>tmpl</folder><folder>licenses</folder><filename>README.txt</filename></files>
  <media destination="mod_antidrone_design" folder="media"><folder>app</folder><filename>embed.js</filename><filename>embed.css</filename></media>
  <config><fields name="params"><fieldset name="basic">
    <field name="site_form_requests" type="radio" default="1" label="Использовать форму сайта" description="Отправка через существующий jQuery и /upload.php этого сайта. Новые настройки почты не нужны."><option value="0">Нет — только просмотр</option><option value="1">Да — существующий обработчик сайта</option></field>
    <field name="cache" type="list" default="0" label="Кэширование"><option value="0">Не кэшировать</option></field>
    <field name="moduleclass_sfx" type="text" default="" label="CSS-класс модуля" />
  </fieldset></fields></config>
</extension>
